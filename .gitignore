# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Google Cloud credentials. These land in the project root by default when
# downloaded from the console — they belong in ~/.config/claude-seo/, never here.
client_secret_*.json
service_account*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Recipient lists uploaded to the emailer. Real contact data, and nothing
# in the app reads it from disk — it is imported through the dashboard.
/excel

# Emailer artwork build inputs. `emailer/build-bands.js` and
# `build-slices.js` regenerate these from Figma, and they total several
# megabytes; only the four creative-* slices the email actually references
# are committed.
/emailer/artwork-2x.png
/emailer/background-full.png
/emailer/src
